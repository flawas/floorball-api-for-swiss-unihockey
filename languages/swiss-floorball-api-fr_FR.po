msgstr "Entrées de proxy de confiance non valides ignorées : %s"

#. translators: %d: number of trusted proxy entries that are used.
#: admin/class-swfl-admin-settings.php:614
#, php-format
msgid "Only the first %d trusted proxy entries are used."
msgstr "Seules les %d premières entrées de proxy de confiance sont utilisées."

#. translators: %s: club name returned by the Swiss Unihockey API.
#: admin/class-swfl-admin-settings.php:796
#, php-format
msgid "Club name automatically set to: %s"
msgstr "Nom du club défini automatiquement : %s"

#. translators: %s: club ID that was entered in the settings.
#: admin/class-swfl-admin-settings.php:807
#, php-format

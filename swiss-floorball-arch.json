  "cards": [
    {
      "dot": "cyan",
      "title": "Plugin Bootstrap & Core Orchestrator",
      "items": [
        "Entry: floorball-api-for-swiss-unihockey.php — defines SWISS_FLOORBALL_API_VERSION",
        "Swiss_Floorball_Api init sequence: load_dependencies() → set_locale() → define_admin_hooks() → define_public_hooks() → run()",
        "Api_Loader buffers all add_action / add_filter calls then executes them all at once on run()"
      ]
    },
    {
      "dot": "violet",
      "title": "Swiss_Floorball_Api_Public — 13 Shortcodes",
      "items": [
        "swfl-club-teams · swfl-club-games · swfl-team-games · swfl-clubs",
        "swfl-calendars · swfl-cups · swfl-groups · swfl-teams",
        "swfl-rankings · swfl-player · swfl-national-players · swfl-topscorers · swfl-game-events",
        "CSS / JS enqueued only when current post contains a plugin shortcode (page_has_shortcode check)"
      ]
    },
    {
      "dot": "amber",
      "title": "Swiss_Floorball_API_Display — God Node (38 edges)",
      "items": [
        "All render_*() methods are static — render_club_games, render_rankings, render_calendars, render_topscorers, render_game_events, render_club_games_cards …",
        "Lazy-initialises API_Client singleton via private get_client()",
        "Reads swissfloorball_club_number and swissfloorball_actual_season from wp_options"
      ]
    },
    {
      "dot": "rose",
      "title": "Swiss_Floorball_API_Client — Transient Cache",
      "items": [
        "Cache key: sfa_ + md5(full URL including all query args) — stored in WP Transients",
        "Default TTL: 3600 s (1 hour); configurable per fetch_data() call",
        "Returns WP_Error on HTTP failure, non-200 status, or JSON parse error",
        "Uses wp_remote_get() via WordPress HTTP API — no raw curl dependency"
      ]
    },
    {
      "dot": "emerald",
      "title": "Swiss_Floorball_Api_Admin — Admin Pages",
      "items": [
        "Settings page: configure swissfloorball_club_number and swissfloorball_actual_season",
        "Club Teams · Club Games / Matches detail view · Shortcode Reference",
        "Helper browsers (read-only): Leagues, Seasons, Teams",
        "CSS / JS enqueued via admin_enqueue_scripts hook only in WP admin context"
      ]
    },
    {
      "dot": "orange",
      "title": "Swiss Unihockey API — External Data Source",
      "items": [
        "Base URL: https://wc.swissunihockey.ch/ — free read-only API, no auth (optional Partner API with token)",
        "Free endpoints: /games?mode=club|team · /games/{id} · /rankings · /clubs/{id}/statistics",
        "/seasons · /clubs · /cups · Partner API only: /leagues · /groups · /topscorers · /game_events/{id}",
        "All API output sanitised with esc_html() / esc_url() / esc_attr() before rendering"
      ]
    }
  ]
